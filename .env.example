# Backend
DATABASE_URL=sqlite:///./data/rawjudge.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=*

# Optional real AI review. Without these variables, the deterministic local agent is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Regional policy profile: global | cn | custom
CONTENT_POLICY_PROFILE=global

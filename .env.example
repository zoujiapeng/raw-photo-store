# RAWJudge development defaults. Docker Compose reads this file after you copy it to .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data/rawjudge.db
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=
TRUSTED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Anonymous bearer sessions. Replace with a long random value before any shared deployment.
TOKEN_PEPPER=rawjudge-local-development-pepper
ALLOW_REGISTRATION=true
SEED_DEMO_DATA=true

# Optional administrator bearer token. Leave blank when the admin API is not needed.
ADMIN_TOKEN=

# Upload and pagination limits.
MAX_IMAGE_BYTES=26214400
MAX_RAW_BYTES=314572800
MAX_IMAGE_PIXELS=80000000
MAX_PAGE_SIZE=100

# Optional OpenAI image assessment. Without a key, deterministic hard rules remain active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
CONTENT_POLICY_PROFILE=global
